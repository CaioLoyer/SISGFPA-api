# SISGFPA — variáveis de ambiente.
# Copie este arquivo para `.env` em: apps/api, apps/chatbot e packages/database
# (cada processo lê o `.env` da sua própria pasta; os scripts da raiz também aceitam um `.env` na raiz).

# --- Compartilhadas (API, Chatbot e Prisma) ---------------------------------
# Conexão com o PostgreSQL. Se a senha tiver @ # / : codifique (ex.: @ vira %40).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sisgfpa"
# String longa e aleatória. Deve ser IGUAL na API e no Chatbot (mesma identidade de usuário).
BETTER_AUTH_SECRET="6fc7ca30f53fa1546aafe6cf54ee7bbead5a474d79df980de008d0e86f35d927"
# URL pública da API (usada pelo Better Auth)
BETTER_AUTH_URL="http://localhost:8080"
# Origens permitidas no CORS / Better Auth, separadas por vírgula (ex.: futuro frontend)
TRUSTED_ORIGINS="http://localhost:3000"
# Requisições por minuto por cliente (opcional)
# RATE_LIMIT_MAX=100

# --- API Financeira ----------------------------------------------------------
PORT=8080

# --- Chatbot -----------------------------------------------------------------
CHATBOT_PORT=3001
# Único canal do Chatbot para o domínio financeiro: HTTP/REST
FINANCIAL_API_URL="http://localhost:8080"
