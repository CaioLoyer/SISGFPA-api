{
  "name": "chatbot",
  "version": "1.0.0",
  "description": "Chatbot Financeiro do SISGFPA: interface conversacional (linguagem natural) para a API Financeira da papelaria",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sisgfpa/auth": "workspace:*",
    "@sisgfpa/database": "workspace:*",
    "@sisgfpa/http": "workspace:*",
    "@sisgfpa/types": "workspace:*",
    "@sisgfpa/validation": "workspace:*",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
