{
  "name": "@sisgfpa/http",
  "version": "1.0.0",
  "private": true,
  "description": "Base Fastify compartilhada por API e Chatbot: app, erros, autenticação por hook, documentação",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "9.7.0",
    "@scalar/fastify-api-reference": "1.51.0",
    "@sisgfpa/auth": "workspace:*",
    "@sisgfpa/types": "workspace:*",
    "@sisgfpa/validation": "workspace:*",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
